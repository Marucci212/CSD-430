<%-- 
  File: results.jsp
  Author: Justin Marucci
  Date: 10/29/2025
  Class: CSD-430 Module 3
  Description:
    Displays the restaurant feedback submitted from index.html.
    Uses scriptlets to read request parameters.
    Outputs values into an HTML table for review/record.
--%>

<%
    // Get form data from POST request
    String custName = request.getParameter("custName");
    String custEmail = request.getParameter("custEmail");
    String visitDate = request.getParameter("visitDate");
    String rating = request.getParameter("rating");
    String favoriteItem = request.getParameter("favoriteItem");
    String comments = request.getParameter("comments");

    // Simple null-safety fallback (in case anything wasn't sent)
    if (custName == null) custName = "";
    if (custEmail == null) custEmail = "";
    if (visitDate == null) visitDate = "";
    if (rating == null) rating = "";
    if (favoriteItem == null) favoriteItem = "";
    if (comments == null) comments = "";
%>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Feedback Summary</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>

    <h1>Thank You For Your Feedback</h1>
    <p>Below is a summary of what you submitted. This information helps us improve service and food quality.</p>

    <table class="results-table" border="1" cellpadding="8" cellspacing="0">
        <thead>
            <tr>
                <th>Field</th>
                <th>Your Response</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Your Name</td>
                <td><%= custName %></td>
                <td>Used to follow up if we have questions</td>
            </tr>
            <tr>
                <td>Email</td>
                <td><%= custEmail %></td>
                <td>Optional contact info</td>
            </tr>
            <tr>
                <td>Date of Visit</td>
                <td><%= visitDate %></td>
                <td>When this experience happened</td>
            </tr>
            <tr>
                <td>Overall Rating (1-5)</td>
                <td><%= rating %></td>
                <td>How satisfied you were overall</td>
            </tr>
            <tr>
                <td>Favorite Menu Item</td>
                <td><%= favoriteItem %></td>
                <td>What you liked most</td>
            </tr>
            <tr>
                <td>Comments</td>
                <td><%= comments %></td>
                <td>Specific praise or issues with service/food</td>
            </tr>
        </tbody>
    </table>

    <br>

    <a href="index.html">Submit another response</a>

    <hr>

    <footer>
        <p>Data summary generated by JSP Scriptlets on the server.</p>
        <p>Course: CSD-430 • Module 3 • Author: Justin Marucci • Date: 10/29/2025</p>
    </footer>

</body>
</html>
